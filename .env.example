# ============================================
# MyAI-Agent environment configuration
# --------------------------------------------
# Copy this file to ".env" (in the project root) and fill in real values.
# .env is gitignored and must NEVER be committed, shared, or pasted into chat.
# Real secret values are never logged by the application.
# ============================================

# --- Server ---
# Leave HOST empty to accept connections from your phone on the same Wi-Fi.
# Set 127.0.0.1 to restrict access to this computer only.
HOST=
PORT=3001

# --- AI adapter ---
# Provider name: mock, gemini, openai, huggingface, or ollama
AI_PROVIDER=mock
# API key for the selected provider. Keep this secret; leave empty for offline mode.
AI_API_KEY=
# Optional model override.
# Defaults: gemini-flash-latest, gpt-4o-mini, meta-llama/Meta-Llama-3-8B-Instruct, or llama3.
AI_MODEL=
# Set true only for local debugging; logs prompt text (API keys are redacted).
DEBUG_CHAT_PROMPTS=false

# --- Storage (SQLite via Node's built-in node:sqlite) ---
# Path is relative to the server/ folder; this folder is git-ignored
DATABASE_PATH=./data/app.db

# --- Sandboxed workspace ---
# Root directory where agent-created project files are allowed to live.
# Anything outside this directory requires explicit user approval.
# Path is relative to the server/ folder; git-ignored
WORKSPACE_ROOT=./workspaces
