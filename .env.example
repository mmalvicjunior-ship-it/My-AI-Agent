# ============================================
# MyAI-Agent environment configuration
# --------------------------------------------
# Copy this file to ".env" and fill in real values.
# .env is gitignored and must NEVER be committed or shared.
# Real secret values are never logged by the application.
# ============================================

# --- Server ---
HOST=127.0.0.1
PORT=3001

# --- AI provider (replaceable adapter) ---
# Provider id used by the adapter layer, e.g. openai, anthropic, local (future)
AI_PROVIDER=
# API key issued by your chosen provider (keep this secret)
AI_API_KEY=
# Model name supported by that provider
AI_MODEL=

# --- Storage (SQLite via Node's built-in node:sqlite) ---
# Path is relative to the server/ folder
DATABASE_PATH=./data/myai-agent.sqlite

# --- Isolated workspace for AI-created projects ---
# Path is relative to the server/ folder; file operations are restricted to it
WORKSPACE_ROOT=./workspaces
