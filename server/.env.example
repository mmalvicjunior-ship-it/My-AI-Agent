# Copy this file to .env and fill in your values.
# NEVER commit the real .env file. NEVER paste real keys into chat or logs.

# --- Server ---
PORT=3001

# --- AI adapter (configured in Phase 3) ---
# Provider name; "mock" returns canned responses until a real provider is set
AI_PROVIDER=mock
# API key for the chosen provider (leave empty while using "mock")
AI_API_KEY=
# Model identifier, e.g. gpt-4o-mini or similar
AI_MODEL=

# --- Sandboxed workspace ---
# Root directory where agent-created project files are allowed to live.
# Anything outside this directory requires explicit user approval.
WORKSPACE_ROOT=./workspaces
