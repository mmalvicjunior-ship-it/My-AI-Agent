# ============================================
# MyAI-Agent environment configuration
# --------------------------------------------
# Copy this file to ".env" (in the project root) and fill in real values.
# .env is gitignored and must NEVER be committed, shared, or pasted into chat.
# Real secret values are never logged by the application.
# ============================================

# --- Server ---
# Leave HOST empty to accept connections from your phone on the same Wi-Fi.
# Set 127.0.0.1 to restrict access to this computer only.
HOST=
PORT=3001

# --- AI adapter ---
# Startup provider: mock, gemini, openai, huggingface, or ollama.
# The chat selector can switch between OpenRouter ("openai") and Google Gemini
# at runtime; background tasks keep using this startup provider.
AI_PROVIDER=mock
# OpenRouter / OpenAI-compatible credentials. Keep this secret.
AI_API_KEY=
# Optional OpenRouter/OpenAI model override.
# Defaults: gpt-4o-mini, meta-llama/Meta-Llama-3-8B-Instruct, or llama3.
AI_MODEL=
# Optional OpenAI-compatible API base URL (e.g. https://openrouter.ai/api/v1).
# Leave empty to use OpenAI's official API.
OPENAI_BASE_URL=
# Google Gemini credentials, independent from the OpenRouter values above.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
# Set true only for local debugging; logs prompt text (API keys are redacted).
DEBUG_CHAT_PROMPTS=false

# --- Storage (SQLite via Node's built-in node:sqlite) ---
# Path is relative to the server/ folder; this folder is git-ignored
DATABASE_PATH=./data/app.db

# --- Sandboxed workspace ---
# Root directory where agent-created project files are allowed to live.
# Anything outside this directory requires explicit user approval.
# Path is relative to the server/ folder; git-ignored
WORKSPACE_ROOT=./workspaces

# --- Accounts and sessions ---
# Session lifetime in days (1-365). Tokens are random bearer values; only their
# SHA-256 hashes are stored in SQLite. Passwords are scrypt hashes.
AUTH_SESSION_DAYS=30
# Set false after creating your account to close public registration.
# The first account adopts projects created before authentication was enabled.
ALLOW_REGISTRATION=true
# Shared secret required to create the FIRST account only. Registration of the
# very first account fails with 403 while this is empty. Generate one before
# the first deploy (for example with Node):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The token is only read while no user accounts exist, and is ignored
# afterwards. Leave empty in committed files; set a real value in .env/Render.
BOOTSTRAP_TOKEN=
# --- Google sign-in (optional) ---
# Authorization-code flow, handled entirely on the server. The client secret
# never reaches the frontend. Leave all three Google values empty to hide the
# "Continue with Google" button. Set these on Render (the backend); nothing
# Google-related belongs on Vercel, except optionally APP_ORIGIN when the
# frontend is served from a different origin than the API.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console -> APIs & Services -> Credentials. See docs/GOOGLE-OAUTH.md for the
# full setup and the redirect URI to register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in the Google Cloud Console
# client, e.g. https://<your-vercel-app>/api/auth/google/callback
# (local dev: http://localhost:5173/api/auth/google/callback)
GOOGLE_OAUTH_REDIRECT_URI=
# Optional: base URL the browser is sent back to after the Google callback.
# Leave empty to use a same-origin relative redirect (works behind the Vercel
# /api rewrite and the Vite dev proxy). Set it only when the frontend lives on
# a different origin than the callback. Must be an absolute https origin with
# no credentials, path, query or fragment; http: is accepted only for
# localhost development. An invalid value fails startup closed.
APP_ORIGIN=
# Rate limiting sits behind a reverse proxy (Render, Vercel, nginx, ...).
# TRUST_PROXY is the number of proxy hops to trust when reading the client IP
# from X-Forwarded-For. Render and Vercel use exactly one hop. Set 0 (or
# "false") when the server is reached directly, or a higher number for a
# known multi-hop chain. Never trust more hops than your proxy chain
# actually uses, or clients can spoof their IP. Other accepted values:
# a comma-separated list of proxy CIDRs/IPs (e.g. "10.0.0.0/8,192.168.1.10").
TRUST_PROXY=1

# --- Optional existing-directory imports ---
# POST /api/projects?path= is disabled unless this is set. When set, imported
# directories must resolve inside this root; paths inside WORKSPACE_ROOT are
# always rejected. Leave empty for the safest configuration.
# Path is relative to the server/ folder unless absolute.
PROJECT_IMPORT_ROOT=

# --- Optional persistent storage backends ---
# Defaults below keep the original SQLite database and local workspace files.
# sqlite + local is the only mode used by the checked-in deployment files.
DATABASE_BACKEND=sqlite
# Required when DATABASE_BACKEND=postgres (Neon or any PostgreSQL server).
# NEON_DATABASE_URL is accepted as an alias. Keep this secret; never commit it.
DATABASE_URL=
NEON_DATABASE_URL=
# TLS defaults are secure. Set either to false only for a controlled local test.
DATABASE_SSL=true
DATABASE_REJECT_UNAUTHORIZED=true
# Timeout for the synchronous storage bridge used by Postgres/S3 workers.
STORAGE_BRIDGE_TIMEOUT_MS=60000
# local (default) or s3. "memory" is a test-only in-memory implementation.
WORKSPACE_STORAGE=local
WORKSPACE_S3_ENDPOINT=
WORKSPACE_S3_BUCKET=
WORKSPACE_S3_REGION=auto
WORKSPACE_S3_ACCESS_KEY=
WORKSPACE_S3_SECRET_KEY=
WORKSPACE_S3_PREFIX=workspaces
# Local PGlite compatibility tests may persist here. Not used by sqlite/postgres.
PGLITE_DATA_DIR=

# --- Optional Python command support ---
# python_check parses Python without running project code. python_run executes a
# pinned .py file only in trusted single-user mode and only after approval.
# Empty uses "python" on Windows and "python3" elsewhere. Python 3.12+ required.
# Local Windows 3.12.10 example (never copy a Windows path to Render):
# PYTHON_BIN=C:\Users\Malvic\AppData\Local\Python\pythoncore-3.12-64\python.exe
PYTHON_BIN=
# Backend-only subprocess limits. These are not a sandbox: generated Python
# still runs with the server account's OS privileges.
PYTHON_RUN_TIMEOUT_MS=30000
PYTHON_RUN_MAX_OUTPUT_BYTES=16000
